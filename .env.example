# =============================================================================
# Environment variables — copy this file to `.env.local` and fill in the values
#
#   cp .env.example .env.local
#
# Rules:
#   - Variables starting with NEXT_PUBLIC_ are visible in the browser. Never put
#     secrets (API keys, passwords) in them.
#   - Everything else stays on the server only.
#   - `.env.local` is git-ignored and must never be committed.
# =============================================================================

# --- Public site settings ----------------------------------------------------
# Canonical domain used for SEO tags, Open Graph and the sitemap.
# In production this must match the real domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default color theme before the visitor picks one: light | dark | system
NEXT_PUBLIC_DEFAULT_THEME=system

# Google Analytics 4 measurement ID (leave empty to disable).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Server-only secrets (never exposed to the browser) ----------------------
# Transactional email provider used by the contact/newsletter forms.
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_FORM_TO_EMAIL=hello@nexora.tech

# Sender address used by sendEmail() in src/app/api/contact/route.ts.
# Most providers accept the "Name <email>" form shown here.
CONTACT_FORM_FROM_EMAIL="Nexora Website <onboarding@resend.dev>"

# Contact API rate limiting lives in code (5 requests / 10 min per IP) —
# see src/app/api/contact/route.ts.

# Optional: verify the origin of form submissions (Vercel deployments).
CRON_SECRET=
